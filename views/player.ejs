<%
  const isSeries = !stream.isMovie;
  const bestStream = stream.streams.find(s => s.resolution === 720) || stream.streams.find(s => s.resolution === 1080) || stream.streams[0];
  const pageTitle = isSeries 
    ? `Nonton ${stream.title} S${stream.season} E${stream.episode} — MovieNas` 
    : `Nonton ${stream.title} Sub Indo — MovieNas`;
%>
<%- include('partials/header', { 
  pageTitle: pageTitle,
  metaDescription: `Nonton streaming ${stream.title} kualitas ${bestStream ? bestStream.quality : 'HD'} dengan subtitle Indonesia di MovieNas.`,
  activeNav: ''
}) %>

<!-- Player Page Container -->
<main class="player-page-container">

  <!-- Top Bar in Player -->
  <div class="player-top-bar">
    <a href="/detail/<%= encodeURIComponent(stream.detailPath) %>" class="player-back-btn">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Kembali ke Detail</span>
    </a>

    <div class="player-title-info">
      <h2 class="player-main-title"><%= stream.title %></h2>
      <p class="player-sub-title">
        <%= isSeries ? `Season ${stream.season} • Episode ${stream.episode}` : 'Film Layar Lebar' %>
      </p>
    </div>

    <div>
      <button class="btn btn-secondary" style="padding: 0.45rem 0.9rem; font-size: 0.8rem;"
        data-path="<%= stream.detailPath %>"
        data-title="<%= stream.title %>"
        data-cover="<%= detail ? detail.coverUrl : '' %>"
        data-type="<%= isSeries ? 'Series' : 'Movie' %>"
        data-rating="<%= detail ? detail.imdbRating : '8.0' %>"
        data-year="<%= detail ? detail.year : '2024' %>"
        onclick="toggleWatchlistFromButton(this)">
        <i class="fa-solid fa-bookmark"></i> Watchlist
      </button>
    </div>
  </div>

  <!-- Custom Video Player Container -->
  <div class="video-wrapper" id="videoWrapper">
    <video
      id="mainVideo"
      class="video-element"
      playsinline
      preload="metadata"
      crossOrigin="anonymous"
      src="<%= bestStream ? bestStream.proxyUrl : '' %>"
    >
      <% 
        const idSub = (stream.subtitles || []).find(s => s.languageCode.toLowerCase() === 'id' || s.languageName.toLowerCase().includes('indonesia'));
        if (idSub) { 
      %>
        <track kind="subtitles" label="<%= idSub.languageName %>" srclang="<%= idSub.languageCode %>" src="<%= idSub.vttUrl %>" default>
      <% } %>
    </video>

    <!-- Center Play Button -->
    <div class="player-center-play-btn" id="centerPlayBtn" title="Putar Video">
      <i class="fa-solid fa-play"></i>
    </div>

    <!-- Spinner -->
    <div class="player-loading-spinner" id="playerSpinner"></div>

    <!-- Control Bar -->
    <div class="player-controls-bar" id="controlsBar">
      <div class="progress-container" id="progressContainer">
        <div class="progress-buffer-bar" id="progressBuffer"></div>
        <div class="progress-filled-bar" id="progressFilled"></div>
        <div class="progress-thumb" id="progressThumb"></div>
      </div>

      <div class="controls-row">
        <!-- Left -->
        <div class="controls-group-left">
          <button class="ctrl-btn" id="playPauseBtn" title="Play / Pause (Spasi)">
            <i class="fa-solid fa-play"></i>
          </button>
          <button class="ctrl-btn" id="rewindBtn" title="Mundur 10 Detik (←)">
            <i class="fa-solid fa-rotate-left"></i>
          </button>
          <button class="ctrl-btn" id="forwardBtn" title="Maju 10 Detik (→)">
            <i class="fa-solid fa-rotate-right"></i>
          </button>

          <div class="volume-wrapper">
            <button class="ctrl-btn" id="volumeBtn" title="Mute / Unmute (M)">
              <i class="fa-solid fa-volume-high"></i>
            </button>
            <input type="range" id="volumeSlider" class="volume-slider" min="0" max="1" step="0.05" value="1" />
          </div>

          <div class="time-display">
            <span id="currentTime">00:00</span> / <span id="durationTime">00:00</span>
          </div>
        </div>

        <!-- Right -->
        <div class="controls-group-right">
          <!-- Speed -->
          <div class="player-select-wrap">
            <button class="player-select-btn" id="speedBtn" title="Kecepatan Putar">
              <span id="speedLabel">1x</span>
              <i class="fa-solid fa-chevron-up" style="font-size: 0.65rem;"></i>
            </button>
            <div class="player-dropdown-menu" id="speedDropdown">
              <div class="dropdown-item" data-speed="0.5">0.5x</div>
              <div class="dropdown-item" data-speed="0.75">0.75x</div>
              <div class="dropdown-item active" data-speed="1">1.0x (Normal)</div>
              <div class="dropdown-item" data-speed="1.25">1.25x</div>
              <div class="dropdown-item" data-speed="1.5">1.5x</div>
              <div class="dropdown-item" data-speed="2">2.0x</div>
            </div>
          </div>

          <!-- Subtitles (Pre-rendered!) -->
          <div class="player-select-wrap">
            <button class="player-select-btn" id="subBtn" title="Subtitle / Takarir">
              <i class="fa-solid fa-closed-captioning"></i>
              <span id="subLabel">Sub: <%= idSub ? idSub.languageName : 'Nonaktif' %></span>
              <i class="fa-solid fa-chevron-up" style="font-size: 0.65rem;"></i>
            </button>
            <div class="player-dropdown-menu" id="subDropdown">
              <div class="dropdown-item <%= !idSub ? 'active' : '' %>" data-sub="off" onclick="switchSubtitleSSR('off')">Matikan Subtitle</div>
              <% (stream.subtitles || []).forEach(function(sub) { 
                const isCurrent = idSub && idSub.id === sub.id;
              %>
                <div class="dropdown-item <%= isCurrent ? 'active' : '' %>" data-sub="<%= sub.id %>" onclick="switchSubtitleSSR('<%= sub.id %>', '<%= sub.vttUrl %>', '<%= sub.languageName %>', '<%= sub.languageCode %>')">
                  <span><%= sub.languageName %></span>
                  <span class="text-xs text-slate-500 uppercase"><%= sub.languageCode %></span>
                </div>
              <% }); %>
            </div>
          </div>

          <!-- Quality (Pre-rendered!) -->
          <div class="player-select-wrap">
            <button class="player-select-btn" id="qualityBtn" title="Kualitas Video">
              <i class="fa-solid fa-gear"></i>
              <span id="qualityLabel"><%= bestStream ? bestStream.quality : 'Auto' %></span>
              <i class="fa-solid fa-chevron-up" style="font-size: 0.65rem;"></i>
            </button>
            <div class="player-dropdown-menu" id="qualityDropdown">
              <% stream.streams.forEach(function(s) { 
                const isCurrent = bestStream && bestStream.quality === s.quality;
              %>
                <div class="dropdown-item <%= isCurrent ? 'active' : '' %>" data-quality="<%= s.quality %>" onclick="switchQualitySSR('<%= s.quality %>', '<%= s.proxyUrl %>')">
                  <span><%= s.quality %></span>
                  <% if (s.sizeFormatted) { %>
                    <span class="text-xs text-slate-500"><%= s.sizeFormatted %></span>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>

          <!-- Fullscreen -->
          <button class="ctrl-btn" id="fullscreenBtn" title="Layar Penuh (F)">
            <i class="fa-solid fa-expand"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Series Episodes Navigation (Server-Side Rendered!) -->
  <% if (isSeries && detail && detail.resource && detail.resource.seasons) { 
    const curSeasonObj = detail.resource.seasons.find(s => s.seasonNumber === stream.season) || detail.resource.seasons[0];
    const episodes = curSeasonObj ? (curSeasonObj.allEpisodes || [1]) : [1];
    const curIdx = episodes.indexOf(stream.episode);
    const prevEp = curIdx > 0 ? episodes[curIdx - 1] : null;
    const nextEp = curIdx < episodes.length - 1 ? episodes[curIdx + 1] : null;
  %>
    <div class="player-below-section">
      <div class="series-navigation-bar">
        <div>
          <h4 class="text-sm font-bold text-white mb-1">Daftar Episode — Season <%= stream.season %></h4>
          <p class="text-xs text-slate-400">Pilih nomor episode untuk berpindah tontonan seketika</p>
        </div>

        <div style="display: flex; gap: 0.75rem;">
          <% if (prevEp) { %>
            <a href="/player?path=<%= encodeURIComponent(stream.detailPath) %>&id=<%= encodeURIComponent(stream.subjectId) %>&se=<%= stream.season %>&ep=<%= prevEp %>" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.8rem;">
              <i class="fa-solid fa-chevron-left"></i> Episode <%= prevEp %>
            </a>
          <% } %>
          <% if (nextEp) { %>
            <a href="/player?path=<%= encodeURIComponent(stream.detailPath) %>&id=<%= encodeURIComponent(stream.subjectId) %>&se=<%= stream.season %>&ep=<%= nextEp %>" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.8rem;">
              Episode <%= nextEp %> <i class="fa-solid fa-chevron-right"></i>
            </a>
          <% } %>
        </div>
      </div>

      <!-- Quick horizontal buttons for all episodes in this season -->
      <div class="series-episodes-list-horizontal">
        <% episodes.forEach(function(ep) { 
          const isCurrent = ep === stream.episode;
          const epUrl = `/player?path=${encodeURIComponent(stream.detailPath)}&id=${encodeURIComponent(stream.subjectId)}&se=${stream.season}&ep=${ep}`;
        %>
          <a href="<%= epUrl %>" class="ep-btn-quick <%= isCurrent ? 'current' : '' %>">
            <span class="ep-num"><%= ep %></span>
            <span>EP</span>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

</main>

<script>
  // Player SSR Interactivity Script
  const detailPath = '<%= stream.detailPath %>';
  const subjectId = '<%= stream.subjectId %>';
  const isMovie = <%= stream.isMovie %>;
  const currentSeason = <%= stream.season %>;
  const currentEpisode = <%= stream.episode %>;
  const coverUrl = '<%= detail ? detail.coverUrl : '' %>';

  const video = document.getElementById('mainVideo');
  const videoWrapper = document.getElementById('videoWrapper');
  const controlsBar = document.getElementById('controlsBar');
  const playPauseBtn = document.getElementById('playPauseBtn');
  const centerPlayBtn = document.getElementById('centerPlayBtn');
  const rewindBtn = document.getElementById('rewindBtn');
  const forwardBtn = document.getElementById('forwardBtn');
  const progressContainer = document.getElementById('progressContainer');
  const progressFilled = document.getElementById('progressFilled');
  const progressBuffer = document.getElementById('progressBuffer');
  const progressThumb = document.getElementById('progressThumb');
  const currentTimeElem = document.getElementById('currentTime');
  const durationTimeElem = document.getElementById('durationTime');
  const volumeBtn = document.getElementById('volumeBtn');
  const volumeSlider = document.getElementById('volumeSlider');
  const fullscreenBtn = document.getElementById('fullscreenBtn');

  let isScrubbing = false;
  let controlsTimeout = null;

  // Toggle Play / Pause
  function togglePlay() {
    if (video.paused) {
      video.play().catch(() => {});
    } else {
      video.pause();
    }
  }

  playPauseBtn.addEventListener('click', togglePlay);
  centerPlayBtn.addEventListener('click', togglePlay);
  video.addEventListener('click', togglePlay);

  video.addEventListener('play', () => {
    playPauseBtn.innerHTML = '<i class="fa-solid fa-pause"></i>';
    centerPlayBtn.classList.add('hidden');
    resetControlsTimer();
  });

  video.addEventListener('pause', () => {
    playPauseBtn.innerHTML = '<i class="fa-solid fa-play"></i>';
    centerPlayBtn.classList.remove('hidden');
    controlsBar.classList.remove('inactive');
  });

  rewindBtn.addEventListener('click', () => {
    video.currentTime = Math.max(0, video.currentTime - 10);
    resetControlsTimer();
  });

  forwardBtn.addEventListener('click', () => {
    video.currentTime = Math.min(video.duration, video.currentTime + 10);
    resetControlsTimer();
  });

  // Time & Progress
  video.addEventListener('timeupdate', () => {
    if (isScrubbing || isNaN(video.duration)) return;
    const current = video.currentTime;
    const duration = video.duration;
    const pct = (current / duration) * 100;
    progressFilled.style.width = `${pct}%`;
    progressThumb.style.left = `${pct}%`;
    currentTimeElem.textContent = StreamBoxApp.formatTime(current);
    durationTimeElem.textContent = StreamBoxApp.formatTime(duration);

    if (video.buffered.length > 0) {
      const bufEnd = video.buffered.end(video.buffered.length - 1);
      progressBuffer.style.width = `${(bufEnd / duration) * 100}%`;
    }
  });

  // Seeking
  function seek(e) {
    const rect = progressContainer.getBoundingClientRect();
    const pos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    video.currentTime = pos * video.duration;
    progressFilled.style.width = `${pos * 100}%`;
    progressThumb.style.left = `${pos * 100}%`;
  }

  progressContainer.addEventListener('mousedown', (e) => { isScrubbing = true; seek(e); });
  window.addEventListener('mousemove', (e) => { if (isScrubbing) seek(e); });
  window.addEventListener('mouseup', () => { isScrubbing = false; });

  // Volume
  volumeSlider.addEventListener('input', (e) => {
    video.volume = parseFloat(e.target.value);
    video.muted = false;
    updateVolIcon();
  });

  volumeBtn.addEventListener('click', () => {
    video.muted = !video.muted;
    updateVolIcon();
  });

  function updateVolIcon() {
    if (video.muted || video.volume === 0) {
      volumeBtn.innerHTML = '<i class="fa-solid fa-volume-xmark"></i>';
    } else if (video.volume < 0.5) {
      volumeBtn.innerHTML = '<i class="fa-solid fa-volume-low"></i>';
    } else {
      volumeBtn.innerHTML = '<i class="fa-solid fa-volume-high"></i>';
    }
  }

  // Fullscreen
  fullscreenBtn.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      if (videoWrapper.requestFullscreen) videoWrapper.requestFullscreen();
    } else {
      if (document.exitFullscreen) document.exitFullscreen();
    }
  });

  // Dropdown helper
  function setupDropdown(btnId, menuId) {
    const btn = document.getElementById(btnId);
    const menu = document.getElementById(menuId);
    if (!btn || !menu) return;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const show = menu.classList.contains('show');
      document.querySelectorAll('.player-dropdown-menu').forEach(m => m.classList.remove('show'));
      if (!show) menu.classList.add('show');
    });
  }

  setupDropdown('speedBtn', 'speedDropdown');
  setupDropdown('subBtn', 'subDropdown');
  setupDropdown('qualityBtn', 'qualityDropdown');
  window.addEventListener('click', () => {
    document.querySelectorAll('.player-dropdown-menu').forEach(m => m.classList.remove('show'));
  });

  // Quality switch (SSR)
  function switchQualitySSR(quality, proxyUrl) {
    const prevTime = video.currentTime;
    const wasPlaying = !video.paused;
    video.src = proxyUrl;
    video.currentTime = prevTime;
    document.getElementById('qualityLabel').textContent = quality;
    document.querySelectorAll('#qualityDropdown .dropdown-item').forEach(i => {
      i.classList.toggle('active', i.getAttribute('data-quality') === quality);
    });
    if (wasPlaying) video.play().catch(() => {});
    StreamBoxApp.showToast(`Kualitas diubah ke ${quality}`);
  }

  // Subtitle switch (SSR)
  function switchSubtitleSSR(subId, vttUrl, langName, langCode) {
    while (video.firstChild) video.removeChild(video.firstChild);
    document.querySelectorAll('#subDropdown .dropdown-item').forEach(i => {
      i.classList.toggle('active', i.getAttribute('data-sub') === subId);
    });
    if (subId === 'off') {
      document.getElementById('subLabel').textContent = 'Sub: Nonaktif';
      return;
    }
    document.getElementById('subLabel').textContent = `Sub: ${langName}`;
    const track = document.createElement('track');
    track.kind = 'subtitles';
    track.label = langName;
    track.srclang = langCode;
    track.src = vttUrl;
    track.default = true;
    video.appendChild(track);
    if (video.textTracks && video.textTracks.length > 0) {
      video.textTracks[0].mode = 'showing';
    }
    StreamBoxApp.showToast(`Subtitle aktif: ${langName}`);
  }

  // Speed
  document.querySelectorAll('#speedDropdown .dropdown-item').forEach(item => {
    item.addEventListener('click', () => {
      const spd = parseFloat(item.getAttribute('data-speed'));
      video.playbackRate = spd;
      document.getElementById('speedLabel').textContent = `${spd}x`;
      document.querySelectorAll('#speedDropdown .dropdown-item').forEach(i => i.classList.remove('active'));
      item.classList.add('active');
    });
  });

  // Auto-hide controls
  function resetControlsTimer() {
    controlsBar.classList.remove('inactive');
    clearTimeout(controlsTimeout);
    controlsTimeout = setTimeout(() => {
      if (!video.paused && !isScrubbing) controlsBar.classList.add('inactive');
    }, 3500);
  }
  videoWrapper.addEventListener('mousemove', resetControlsTimer);

  // Resume Playback from localStorage if available
  video.addEventListener('loadedmetadata', () => {
    const history = StreamBoxApp.getHistoryItem(detailPath);
    if (history && history.currentTime > 15) {
      if (isMovie || (history.season === currentSeason && history.episode === currentEpisode)) {
        video.currentTime = history.currentTime;
        StreamBoxApp.showToast(`Melanjutkan dari posisi ${StreamBoxApp.formatTime(history.currentTime)}`);
      }
    }
  });

  // Save Progress every 5s
  setInterval(() => {
    if (video && !video.paused && video.currentTime > 5) {
      StreamBoxApp.saveHistory({
        detailPath,
        subjectId,
        title: '<%= stream.title.replace(/\'/g, "") %>',
        coverUrl,
        isMovie,
        season: currentSeason,
        episode: currentEpisode,
        currentTime: video.currentTime,
        duration: video.duration || 0,
      });
    }
  }, 5000);
</script>

<%- include('partials/footer') %>
