<%- include('partials/header', { 
  pageTitle: 'MovieNas — Nonton Film & Series Subtitle Indonesia Gratis',
  metaDescription: heroItem ? `Nonton ${heroItem.title} dan ribuan film & series lainnya dengan sub Indo kualitas HD di MovieNas.` : 'Streaming film & series sub Indo terlengkap.',
  ogImage: heroItem ? (heroItem.coverUrl || heroItem.stillsUrl) : '/placeholder.jpg',
  ogType: 'website',
  activeNav: 'home'
}) %>

<% if (heroItem) { 
  const isSeries = heroItem.typeLabel === 'Series' || heroItem.subjectType === 2;
  const bgImg = heroItem.stillsUrl || heroItem.coverUrl;
%>
  <!-- Hero Banner (Server-Side Rendered) -->
  <section class="hero" id="heroBanner" style="background-image: url('<%= bgImg %>');">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-badge-row">
        <span class="badge badge-brand"><i class="fa-solid fa-bolt"></i> TRENDING #1</span>
        <span class="badge <%= isSeries ? 'badge-type-series' : 'badge-type-movie' %>"><%= isSeries ? 'Series' : 'Movie' %></span>
        <span class="badge badge-rating">
          <i class="fa-solid fa-star"></i>
          <span><%= heroItem.imdbRating || '8.5' %></span>
        </span>
        <span class="badge badge-quality">Full HD</span>
        <span class="badge badge-meta"><%= heroItem.year || (heroItem.releaseDate ? heroItem.releaseDate.split('-')[0] : '2024') %></span>
        <span class="badge badge-meta"><%= heroItem.durationFormatted || (isSeries ? 'Series' : 'Film') %></span>
      </div>

      <h1 class="hero-title"><%= heroItem.title %></h1>
      
      <% if (heroItem.genre && heroItem.genre.length > 0) { %>
        <div class="hero-genres">
          <% heroItem.genre.slice(0, 4).forEach(function(g) { %>
            <span class="genre-chip"><%= g %></span>
          <% }); %>
        </div>
      <% } %>

      <p class="hero-desc"><%= heroItem.description || 'Streaming film dan series pilihan berkualitas tinggi.' %></p>

      <div class="hero-actions">
        <a href="/player?path=<%= encodeURIComponent(heroItem.detailPath) %>" class="btn btn-primary">
          <i class="fa-solid fa-play"></i> Putar Sekarang
        </a>
        <a href="/detail/<%= encodeURIComponent(heroItem.detailPath) %>" class="btn btn-secondary">
          <i class="fa-solid fa-circle-info"></i> Info Lengkap
        </a>
        <button class="btn btn-secondary"
          data-path="<%= heroItem.detailPath %>"
          data-title="<%= heroItem.title %>"
          data-cover="<%= heroItem.coverUrl %>"
          data-type="<%= heroItem.typeLabel %>"
          data-rating="<%= heroItem.imdbRating %>"
          data-year="<%= heroItem.year %>"
          onclick="toggleWatchlistFromButton(this)">
          <i class="fa-solid fa-plus"></i> Watchlist
        </button>
      </div>
    </div>
  </section>
<% } %>

<!-- Main Content Container -->
<main class="main-container">

  <!-- Continue Watching Section (LocalStorage) -->
  <section class="content-section" id="continueWatchingSection" style="display: none;">
    <div class="section-header">
      <div class="section-title-wrap">
        <div class="section-title-bar"></div>
        <h2 class="section-title">Lanjutkan Menonton</h2>
        <span class="section-subtitle">Tersimpan otomatis</span>
      </div>
      <button onclick="StreamBoxApp.clearHistory()" class="btn btn-secondary" style="padding: 0.35rem 0.85rem; font-size: 0.75rem;">
        <i class="fa-solid fa-trash-can"></i> Hapus Riwayat
      </button>
    </div>
    <div class="carousel-track" id="continueWatchingTrack">
      <!-- Injected by client app.js -->
    </div>
  </section>

  <!-- Watchlist Section (LocalStorage) -->
  <section class="content-section" id="watchlistSection" style="display: none;">
    <div class="section-header">
      <div class="section-title-wrap">
        <div class="section-title-bar"></div>
        <h2 class="section-title" id="watchlist">Watchlist Saya</h2>
        <span class="section-subtitle">Favorit pilihanmu</span>
      </div>
    </div>
    <div class="carousel-track" id="watchlistTrack">
      <!-- Injected by client app.js -->
    </div>
  </section>

  <!-- Trending Carousel (Server-Side Rendered Real HTML!) -->
  <section class="content-section" id="trending">
    <div class="section-header">
      <div class="section-title-wrap">
        <div class="section-title-bar"></div>
        <h2 class="section-title">Trending Sekarang</h2>
        <span class="section-subtitle">Paling banyak ditonton</span>
      </div>
      <div class="carousel-controls">
        <button class="carousel-btn" onclick="document.getElementById('trendingTrack').scrollBy({ left: -450, behavior: 'smooth' })" title="Geser Kiri">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <button class="carousel-btn" onclick="document.getElementById('trendingTrack').scrollBy({ left: 450, behavior: 'smooth' })" title="Geser Kanan">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </div>
    <div class="carousel-track" id="trendingTrack">
      <% if (trending && trending.length > 0) { %>
        <% trending.slice(0, 15).forEach(function(item) { %>
          <%- include('partials/card', { item: item }) %>
        <% }); %>
      <% } else { %>
        <p class="text-sm text-slate-500 py-4">Tidak ada data trending.</p>
      <% } %>
    </div>
  </section>

  <!-- Movies Carousel (Server-Side Rendered Real HTML!) -->
  <section class="content-section" id="movies">
    <div class="section-header">
      <div class="section-title-wrap">
        <div class="section-title-bar"></div>
        <h2 class="section-title">Film Populer</h2>
        <span class="section-subtitle">Box Office &amp; Blockbuster</span>
      </div>
      <div class="carousel-controls">
        <button class="carousel-btn" onclick="document.getElementById('moviesTrack').scrollBy({ left: -450, behavior: 'smooth' })" title="Geser Kiri">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <button class="carousel-btn" onclick="document.getElementById('moviesTrack').scrollBy({ left: 450, behavior: 'smooth' })" title="Geser Kanan">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </div>
    <div class="carousel-track" id="moviesTrack">
      <% 
        const movies = (trending || []).filter(function(i) { return i.typeLabel === 'Movie' || i.subjectType === 1; });
        const displayMovies = movies.length > 0 ? movies : (trending || []).slice(5, 18);
      %>
      <% displayMovies.forEach(function(item) { %>
        <%- include('partials/card', { item: item }) %>
      <% }); %>
    </div>
  </section>

  <!-- Series Carousel (Server-Side Rendered Real HTML!) -->
  <section class="content-section" id="series">
    <div class="section-header">
      <div class="section-title-wrap">
        <div class="section-title-bar"></div>
        <h2 class="section-title">Serial TV &amp; Drama</h2>
        <span class="section-subtitle">Episode Lengkap Tiap Season</span>
      </div>
      <div class="carousel-controls">
        <button class="carousel-btn" onclick="document.getElementById('seriesTrack').scrollBy({ left: -450, behavior: 'smooth' })" title="Geser Kiri">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <button class="carousel-btn" onclick="document.getElementById('seriesTrack').scrollBy({ left: 450, behavior: 'smooth' })" title="Geser Kanan">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </div>
    <div class="carousel-track" id="seriesTrack">
      <% 
        const series = (trending || []).filter(function(i) { return i.typeLabel === 'Series' || i.subjectType === 2; });
        const displaySeries = series.length > 0 ? series : (trending || []).slice(10, 25);
      %>
      <% displaySeries.forEach(function(item) { %>
        <%- include('partials/card', { item: item }) %>
      <% }); %>
    </div>
  </section>

</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Sync localStorage sections
    renderContinueWatchingSSR();
    renderWatchlistSectionSSR();
    window.addEventListener('history-updated', renderContinueWatchingSSR);
    window.addEventListener('watchlist-updated', renderWatchlistSectionSSR);
  });

  function renderContinueWatchingSSR() {
    const sec = document.getElementById('continueWatchingSection');
    const track = document.getElementById('continueWatchingTrack');
    if (!sec || !track) return;
    const history = StreamBoxApp.getHistory();
    if (history.length === 0) {
      sec.style.display = 'none';
      return;
    }
    sec.style.display = 'block';
    track.innerHTML = history.map(item => {
      const playUrl = `/player?path=${encodeURIComponent(item.detailPath)}&se=${item.season || 0}&ep=${item.episode || 0}&t=${Math.floor(item.currentTime || 0)}`;
      const epText = item.isMovie ? 'Film' : `S${item.season || 1} E${item.episode || 1}`;
      return `
        <div class="cw-card" onclick="window.location.href='${playUrl}'">
          <div class="cw-thumb">
            <img src="${item.coverUrl || ''}" alt="${item.title}" />
            <div class="cw-play-overlay"><i class="fa-solid fa-circle-play"></i></div>
            <div class="cw-progress-bar"><div class="cw-progress-fill" style="width: ${item.percent || 0}%"></div></div>
          </div>
          <div class="cw-info">
            <h4 class="cw-title">${item.title}</h4>
            <p class="cw-episode">${epText} • ${StreamBoxApp.formatTime(item.currentTime)}</p>
          </div>
        </div>
      `;
    }).join('');
  }

  function renderWatchlistSectionSSR() {
    const sec = document.getElementById('watchlistSection');
    const track = document.getElementById('watchlistTrack');
    if (!sec || !track) return;
    const wl = StreamBoxApp.getWatchlist();
    if (wl.length === 0) {
      sec.style.display = 'none';
      return;
    }
    sec.style.display = 'block';
    track.innerHTML = wl.map(item => StreamBoxApp.createPosterCard(item)).join('');
  }
</script>

<%- include('partials/footer') %>
