<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <!-- Disable Zoom In and Zoom Out as requested -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'MovieNas — Nonton Film & Series Subtitle Indonesia Gratis' %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Streaming film & series kualitas 360p-1080p dengan subtitle Indonesia lengkap tanpa buffering di MovieNas.' %>" />
  
  <!-- OpenGraph / Social Media SEO Tags (Rendered from Server!) -->
  <meta property="og:site_name" content="MovieNas" />
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>" />
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'MovieNas — Streaming Movie & Series' %>" />
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Nonton streaming film dan series terlengkap sub Indo di MovieNas.' %>" />
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/placeholder.jpg' %>" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'MovieNas' %>" />
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Streaming film & series sub Indo' %>" />
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/placeholder.jpg' %>" />

  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍿</text></svg>" />
  <!-- FontAwesome & CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- Ambient Animated Lighting -->
  <div class="ambient-glow ambient-glow-1"></div>
  <div class="ambient-glow ambient-glow-2"></div>

  <!-- Top Navbar -->
  <header class="navbar">
    <div class="nav-left">
      <a href="/" class="brand-logo">
        <div class="logo-icon glow-pulse">
          <i class="fa-solid fa-play"></i>
        </div>
        <span>Movie<span class="logo-tag">Nas</span></span>
      </a>

      <ul class="nav-links" id="navLinks">
        <li><a href="/" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'active' : '' %>"><i class="fa-solid fa-house"></i> Beranda</a></li>
        <li><a href="/search?type=1" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'movies' ? 'active' : '' %>"><i class="fa-solid fa-film"></i> Film</a></li>
        <li><a href="/search?type=2" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'series' ? 'active' : '' %>"><i class="fa-solid fa-tv"></i> Series</a></li>
        <li><a href="/#trending" class="nav-link"><i class="fa-solid fa-fire text-amber-400"></i> Trending</a></li>
        <li><a href="/#watchlist" class="nav-link"><i class="fa-solid fa-bookmark"></i> Watchlist</a></li>
      </ul>
    </div>

    <div class="nav-right">
      <div class="search-box">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <form action="/search" method="GET" style="display: flex; width: 100%;">
          <input type="text" name="q" id="navSearchInput" placeholder="Cari film, series... [/]" value="<%= typeof query !== 'undefined' ? query : '' %>" />
        </form>
      </div>

      <a href="/#watchlist" class="watchlist-btn-badge" title="Daftar Tontonan">
        <i class="fa-solid fa-bookmark"></i>
        <span class="badge-count" style="display: none;">0</span>
      </a>

      <button class="menu-toggle" id="menuToggleBtn" aria-label="Toggle Menu">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </header>
