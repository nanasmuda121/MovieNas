<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <!-- Center Buffering Indicator -->
    <ProgressBar
        android:id="@+id/playerProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/brand_red"
        android:visibility="visible" />

    <!-- Top Overlay Bar (Title, Back, PiP, Resize, Speed) -->
    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#CC060609"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btnPlayerBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_search_bar"
            android:contentDescription="Back"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Judul Tayangan"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Memuat sumber video..."
                android:textColor="@color/text_slate"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Aspect Ratio / Resize Button -->
        <ImageView
            android:id="@+id/btnPlayerResize"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_search_bar"
            android:contentDescription="Resize Mode"
            android:padding="9dp"
            android:src="@drawable/ic_aspect_ratio"
            app:tint="@color/text_white" />

        <!-- Picture-in-Picture (PiP) Button -->
        <ImageView
            android:id="@+id/btnPlayerPip"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_search_bar"
            android:contentDescription="Picture-in-Picture"
            android:padding="9dp"
            android:src="@drawable/ic_pip"
            app:tint="@color/text_white" />

    </LinearLayout>

    <!-- Bottom Full Toolbar (Quality, Subtitles, Episodes Navigation) -->
    <LinearLayout
        android:id="@+id/playerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#DD0E0E15"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Episode Navigation Row (Visible for Series / Short Drama) -->
        <LinearLayout
            android:id="@+id/layoutEpisodeNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btnPrevEp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_inactive"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/text_white" />

                <TextView
                    android:id="@+id/tvPrevEpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prev Ep"
                    android:textColor="@color/text_white"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvEpisodeIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Episode 1"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnNextEp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_button_red"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvNextEpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="Next Ep"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/text_white" />

            </LinearLayout>

        </LinearLayout>

        <!-- Quality Resolution Pills Row matching Web -->
        <LinearLayout
            android:id="@+id/layoutQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Resolusi:"
                android:textColor="@color/text_slate"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/qualityContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <!-- Subtitle Pills Row matching Web -->
        <LinearLayout
            android:id="@+id/layoutSubtitles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Subtitle:"
                android:textColor="@color/accent_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/subtitleContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <!-- Playback Speed Row -->
        <LinearLayout
            android:id="@+id/layoutSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Speed:"
                android:textColor="@color/text_slate"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/speedContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
